# 프로젝트 식별 (다른 사용자와 겹치지 않게)
COMPOSE_PROJECT_NAME=newnaeun_ncafe
USER_ID=newnaeun

# 포트 설정 (프론트엔드만 외부 공개)
FRONTEND_PORT=3032

# 보안 (프로덕션에서 반드시 변경)
# [프론트엔드] iron-session 쿠키 암호화 키 (Next.js에서 사용)
SESSION_SECRET=your-secret-key-at-least-32-characters-long
# [백엔드] JWT 토큰 서명/검증 키 (Spring Boot에서 사용)
JWT_SECRET=your-jwt-secret-key-at-least-32-characters-long
# [DB] PostgreSQL 접속 비밀번호
DB_PASSWORD=your-db-password
# [DB] Docker 내부 네트워크에서 DB 접속 URL
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/ncafedb

# 스프링 프로필 (로컬: dev / 서버: prod)
SPRING_PROFILE=dev
